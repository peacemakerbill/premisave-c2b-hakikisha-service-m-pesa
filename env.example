# Local configuration for premisave-c2b-hakikisha-service-m-pesa.
# Loaded automatically via spring.config.import in application.yml. DO NOT COMMIT.

SERVER_PORT=8090
MONGODB_URI=mongodb://localhost:27017/premisave-c2b-hakikisha

# Wallet service (source of the account / name data)
WALLET_SERVICE_URL=http://localhost:8084
# Must match wallet-service's INTERNAL_API_KEY exactly
INTERNAL_API_KEY=change-me-to-the-wallet-service-internal-api-key

# C2B Hakikisha
HAKIKISHA_SHORTCODE=600992
# Default credentials - CHANGE BEFORE SHARING THEM WITH SAFARICOM
HAKIKISHA_USERNAME=change-me
HAKIKISHA_PASSWORD=change-me
HAKIKISHA_TOKEN_TTL_SECONDS=3599

# Wallet -> MongoDB sync job
HAKIKISHA_SYNC_ENABLED=true
HAKIKISHA_SYNC_INTERVAL_MINUTES=5
HAKIKISHA_SYNC_RUN_ON_STARTUP=true
HAKIKISHA_SYNC_PAGE_SIZE=100
HAKIKISHA_SYNC_DELETE_STALE=true
HAKIKISHA_SYNC_CONNECT_TIMEOUT_SECONDS=10
HAKIKISHA_SYNC_READ_TIMEOUT_SECONDS=30
